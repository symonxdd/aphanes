{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "webOS Dev Mode Manager",
  "version": "1.0.0",
  "identifier": "me.symon.aphanes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aphanes: webOS Dev Mode Manager",
        "width": 1056,
        "height": 630,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQkNCRUI3QzhGQ0IxNzMKUldSenNmekl0NzY4UStoQlgwQm9uSnJ3eDJ1ano4YXNIakRjcSt5aTZpL0pqTDdENlkvbGlxcVoK",
      "endpoints": ["https://raw.githubusercontent.com/symonxdd/aphanes/desktop-updates/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
